{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hpc-gateway:workflow-template:1",
  "title": "HPC Gateway Workflow Template",
  "description": "Admin-owned YAML is parsed to this JSON structure. One template compiles to one sequential Slurm script. Template commands are trusted code; end users can only provide typed parameters and uploaded input IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "application", "image", "references", "inputs", "parameters", "resources", "steps", "outputs"],
  "properties": {
    "id": {"$ref": "#/$defs/identifier"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"$ref": "#/$defs/identifier"},
    "application": {"$ref": "#/$defs/identifier"},
    "description": {"type": "string"},
    "image": {"type": "string", "minLength": 1, "description": "Administrator-provisioned local Apptainer SIF image; pinned filename/version recommended."},
    "references": {"type": "object", "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"type": "string", "minLength": 1}},
    "inputs": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "#/$defs/input"}},
    "parameters": {"type": "object", "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "#/$defs/parameter"}},
    "resources": {"$ref": "#/$defs/resources"},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "command"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "command": {"type": "string", "minLength": 1, "maxLength": 65536, "description": "Trusted shell command; placeholders: {{input:key}}, {{param:key}}, {{reference:key}}, {{output:key}}, {{run_dir}}. Every substituted value is POSIX shell quoted. Do not wrap placeholders in shell quotes."}}}},
    "outputs": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "#/$defs/output"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_.-]{0,99}$"},
    "input": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["fastq", "file"]}, "required": {"const": true, "default": true}, "description": {"type": "string"}}},
    "parameter": {"type": "object", "additionalProperties": false, "required": ["type", "default"], "properties": {"type": {"enum": ["string", "integer", "number", "boolean"]}, "default": {"type": ["string", "number", "boolean"]}, "minimum": {"type": "number"}, "maximum": {"type": "number"}, "allowed_values": {"type": "array", "items": {"type": ["string", "number", "boolean"]}}, "format": {"const": "sample_id"}, "description": {"type": "string"}}, "allOf": [{"if": {"properties": {"type": {"const": "string"}}}, "then": {"properties": {"default": {"type": "string", "minLength": 1, "maxLength": 256}}}}, {"if": {"properties": {"type": {"const": "integer"}}}, "then": {"properties": {"default": {"type": "integer"}}}}, {"if": {"properties": {"type": {"const": "number"}}}, "then": {"properties": {"default": {"type": "number"}}}}, {"if": {"properties": {"type": {"const": "boolean"}}}, "then": {"properties": {"default": {"type": "boolean"}}}}]},
    "resources": {"type": "object", "additionalProperties": false, "required": ["cpus", "memory_gb", "time_minutes"], "properties": {"cpus": {"type": "integer", "minimum": 1, "maximum": 128}, "memory_gb": {"type": "integer", "minimum": 1, "maximum": 1024}, "time_minutes": {"type": "integer", "minimum": 1, "maximum": 10080}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["path", "kind"], "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\u0000\\r\\n]+$"}, "kind": {"enum": ["vcf", "file"]}, "required": {"type": "boolean", "default": true}}}
  }
}
